# ==========================================
# shamsul-server configuration
# ==========================================

# Ollama Config (local provider, no API key required)
OLLAMA_BASE_URL="http://localhost:11434"

# Model configurations for context-engineering pipeline
# The Reasoning Lead Model (e.g. gemma2:9b, deepseek-r1:8b)
OLLAMA_REASONING_MODEL="gemma2:9b"

# The Coding Execution Model (e.g. qwen2.5-coder:7b)
OLLAMA_CODING_MODEL="qwen2.5-coder:7b"

# Optional voice and image models
OLLAMA_VOICE_MODEL=""
OLLAMA_IMAGE_MODEL=""

# Mapped model fallback
# Format: provider_type/model/name
MODEL="ollama/qwen2.5-coder:7b"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=

# Thinking output
# Blank per-model switches inherit ENABLE_MODEL_THINKING.
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=
ENABLE_MODEL_THINKING=true

# Server Host and Port
HOST="0.0.0.0"
PORT=8082

# Optional server API key to protect endpoints (empty means no auth)
ANTHROPIC_AUTH_TOKEN=""

# ==================== Context Compression ====================
# Recent turns (user+assistant exchange pairs) to keep uncompressed.
# Tool results outside this window are truncated to a 1-line summary.
# Increase for deep multi-file refactors; decrease for very large codebases.
CONTEXT_RECENT_TURNS=3

# Max characters for any single tool result in the recent window (~750 tokens at 3000 chars).
# Results exceeding this are capped even within the recent window.
CONTEXT_MAX_RESULT_CHARS=3000

# Max lines of code kept in past Write/Edit tool_use blocks in history.
CONTEXT_MAX_WRITE_LINES=10

# Recent turns for the Head Reasoning model (larger = better understanding of what was done).
# 5 gives the head model enough context to understand prior actions without flooding it.
CONTEXT_HEAD_RECENT_TURNS=5
